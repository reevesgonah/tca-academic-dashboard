# Rename this file to secrets.toml locally, or set the same keys under
# your Streamlit Community Cloud app's Settings -> Secrets.

APP_PASSWORD = "put-the-real-staff-password-here"

# ---------------------------------------------------------------------------
# OPTIONAL — private data source. Leave this whole section out (or set
# enabled = false) and the app just reads data/ locally, same as always.
#
# When enabled, the app fetches the real term data from a SEPARATE private
# GitHub repo at runtime instead of from files committed to this app's own
# repo — so a real student's records are never in *this* project's git
# history, public or private.
#
# Setup, one-time:
#   1. Create a new, separate private GitHub repo (e.g. "tca-private-data")
#      and put your real data/scores_long.csv, subject_teachers.csv, and
#      class_teachers.csv in it, at whatever paths you like.
#   2. On GitHub: Settings -> Developer settings -> Personal access tokens
#      -> Fine-grained tokens -> Generate new token.
#        - Repository access: "Only select repositories" -> pick that one
#          private data repo, nothing else.
#        - Permissions: Repository -> Contents -> Read-only. That's the
#          only permission this needs.
#   3. Paste that token below as `token`. Never commit this file with a
#      real token in it — secrets.toml is already covered by .gitignore.
# ---------------------------------------------------------------------------
[data_source]
enabled = false
repo = "yourusername/tca-private-data"
branch = "main"
scores_path = "data/scores_long.csv"
subject_teachers_path = "data/subject_teachers.csv"
class_teachers_path = "data/class_teachers.csv"
token = "github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
